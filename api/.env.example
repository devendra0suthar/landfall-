# Local development. Region-local in production — one database per region (NFR-4).
DATABASE_URL="postgresql://landfall:CHANGE_ME@localhost:5432/landfall"
PORT=5175

# An honest User-Agent needs a real contact address. We never present automated
# traffic as a human browser (NFR-1), and the inbox behind this is read (FR-37).
LANDFALL_CONTACT="you@example.com"

# Where the API writes: cached vendor responses, résumé files, send archives.
# Defaults to ./storage. Point it at a mounted disk in production.
# LANDFALL_STATE_DIR="/var/data/"

# Résumé rewording suggestions (FR-45…FR-48). Optional: with this unset the
# feature switches itself off and says so, and nothing else changes — planning,
# tailoring, scoring, the Kit and letters never call a model.
# ANTHROPIC_API_KEY="sk-ant-..."

# Lets a sign-up adopt an existing account that has no password (the row
# `pnpm seed` writes). Convenient locally; an account takeover in production,
# so it is off there unless this is explicitly "true".
# LANDFALL_ALLOW_CLAIM="true"

# Google sign-in (FR-24). Optional: without these the button is not rendered
# and email sign-in is unaffected. Create an OAuth 2.0 Client ID (type: Web
# application) at https://console.cloud.google.com/apis/credentials and add
# your origin's /api/auth/google/callback as an Authorized redirect URI.
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."
# Only needed if the redirect URI cannot be derived from the request.
# PUBLIC_URL="https://landfall.example.com"
