# Local development. Region-local in production — one database per region (NFR-4).
DATABASE_URL="postgresql://landfall:CHANGE_ME@localhost:5432/landfall"
PORT=5175

# An honest User-Agent needs a real contact address. We never present automated
# traffic as a human browser (NFR-1), and the inbox behind this is read (FR-37).
LANDFALL_CONTACT="you@example.com"

# Where the API writes: cached vendor responses, résumé files, send archives.
# Defaults to ./storage. Point it at a mounted disk in production.
# LANDFALL_STATE_DIR="/var/data/"
