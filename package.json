{
  "name": "landfall",
  "version": "0.1.0",
  "private": true,
  "description": "A worldwide job-application platform. See docs/REQUIREMENTS.md.",
  "scripts": {
    "dev": "pnpm --parallel --filter ./api --filter ./web dev",
    "dev:api": "pnpm --filter ./api dev",
    "dev:web": "pnpm --filter ./web dev",
    "typecheck": "pnpm -r typecheck",
    "db:push": "pnpm --filter ./api db:push",
    "db:studio": "pnpm --filter ./api db:studio",
    "ingest": "pnpm --filter ./api ingest",
    "forms": "pnpm --filter ./api forms",
    "seed": "pnpm --filter ./api seed",
    "test": "pnpm --filter ./api test && pnpm --filter ./extension test",
    "build:extension": "pnpm --filter ./extension build",
    "build": "pnpm install --frozen-lockfile && pnpm --filter ./api exec prisma generate && pnpm --filter ./web build",
    "start": "pnpm --filter ./api exec prisma migrate deploy && pnpm --filter ./api start",
    "migrate": "pnpm --filter ./api exec prisma migrate",
    "facts": "pnpm --filter ./api facts",
    "refresh": "pnpm --filter ./api refresh"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  }
}
